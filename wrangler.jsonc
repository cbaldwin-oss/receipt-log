{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "receipt-capturer",
  "compatibility_date": "2026-08-29",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": true
}
